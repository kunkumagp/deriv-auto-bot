# .env for over_under_bot.js
# Replace with your real Deriv API token
ACCOUNT_TOKEN=lkUxtOopvUhCpIX

# Initial stake as percent of balance (e.g. 0.35 for 0.35%)
INITIAL_STAKE_PERCENT=0.35

# Daily profit target as percent of starting balance (e.g. 5 for 5%)
DAY_TARGET_PERCENT=5

# Session profit target as percent of starting balance (e.g. 2 for 2%)
SESSION_TARGET_PERCENT=2

# Martingale multiplier for loss recovery (e.g. 3)
MARTINGALE_MULTIPLIER=3
